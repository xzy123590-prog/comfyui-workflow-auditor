              "STRING_FILE_URI",
              "STRING_URL_WITH_CREDENTIALS",
              "STRING_PATH_TRAVERSAL",
              "CLI_USAGE",
              "INTERNAL_ERROR",
              "FMT_UNKNOWN",
              "FMT_AMBIGUOUS",
              "FMT_VERSION_INVALID",
              "FMT_VERSION_UNEXPECTED",
              "FMT_REQUIRED_FIELD_MISSING",
              "FMT_FIELD_TYPE_INVALID",
              "WORKFLOW_TOO_MANY_NODES",
              "WORKFLOW_TOO_MANY_LINKS",
