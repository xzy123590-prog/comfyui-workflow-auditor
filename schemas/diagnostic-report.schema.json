              "API_NODE_ID_INVALID",
              "API_NODE_OBJECT_INVALID",
              "API_CLASS_TYPE_MISSING",
              "API_CLASS_TYPE_INVALID",
              "API_INPUTS_MISSING",
              "API_INPUTS_INVALID",
              "API_META_INVALID",
              "API_REFERENCE_SOURCE_MISSING",
              "API_REFERENCE_INDEX_INVALID",
