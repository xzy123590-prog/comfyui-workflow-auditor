              "LINK_ID_INVALID",
              "LINK_ID_DUPLICATE",
              "LINK_ORIGIN_NODE_MISSING",
              "LINK_TARGET_NODE_MISSING",
              "LINK_ORIGIN_SLOT_INVALID",
              "LINK_TARGET_SLOT_INVALID",
