    "schema_version": {
      "const": "1"
    },
    "tool": {
      "const": "comfyui-workflow-auditor"
    },
    "tool_version": {
      "const": "0.1.0.dev0"
    },
    "scope": {
      "enum": [
        "generic-json-security-core",
        "comfyui-workflow-v1",
        "comfyui-workflow-v0.4",
        "comfyui-api-format",
        "format-detection"
      ]
    },
    "input_id": {
      "const": "input-1"
    },
    "fingerprint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "user_opt_in": {
              "const": true
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "user_opt_in",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "info_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_checked_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "error_count",
        "warning_count",
        "info_count",
        "not_checked_count"
      ],
      "additionalProperties": false
    },
